# ==============================================================================
# PORTFOLIO ENVIRONMENT VARIABLES
# ==============================================================================

# 1. Neon PostgreSQL Database (Get from https://neon.tech)
# If provided, the Admin CMS will store and sync all data in Neon Serverless Postgres.
# If omitted, it will automatically fallback to local src/data/portfolio-db.json.
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-sample-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# 2. GitHub Auto-Commit (Optional - to auto-sync JSON changes to GitHub repo)
# GITHUB_TOKEN="ghp_your_personal_access_token_here"
# GITHUB_REPO="filamsimg/filamss-porto"
# GITHUB_BRANCH="main"
