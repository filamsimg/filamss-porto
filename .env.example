# ==============================================================================
# PORTFOLIO ENVIRONMENT VARIABLES
# ==============================================================================

# 1. Admin Security PIN (Login PIN for /admin dashboard)
# Change this to your own private 6-digit or custom PIN code.
NEXT_PUBLIC_ADMIN_PIN=123456

# 2. Neon Serverless PostgreSQL Database (https://neon.tech)
# If provided, the Admin CMS stores & syncs all data to Neon cloud Postgres.
# If left empty, it will automatically fallback to local src/data/portfolio-db.json.
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-sample-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
